{
  "name": "plantuml-studio",
  "productName": "PlantUML Studio",
  "version": "0.1.0",
  "description": "Application desktop 100% offline pour créer des diagrammes UML avec PlantUML",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "rimraf dist release",
    "dev": "concurrently -k -n renderer,tsc,electron -c cyan,magenta,yellow \"npm:dev:renderer\" \"npm:dev:tsc\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:tsc": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js dist/preload/preload.js && cross-env NODE_ENV=development electron .",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux deb rpm",
    "resources:plantuml": "node scripts/download-plantuml.js",
    "resources:jre": "node scripts/download-jre.js",
    "verify:offline": "node scripts/verify-offline.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "adm-zip": "^0.5.18",
    "monaco-editor": "^0.56.0",
    "pdfkit": "^0.19.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svg-to-pdfkit": "^0.1.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
