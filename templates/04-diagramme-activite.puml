' Diagramme d'activité — enchaînement des étapes d'un processus
@startuml
title Traitement d'une demande de congés

start

:Salarié dépose une demande;

if (Solde de congés suffisant ?) then (oui)
  :Notifier le responsable;

  while (Décision prise ?) is (non)
    :Attendre 24 h;
    :Relancer le responsable;
  endwhile (oui)

  if (Demande acceptée ?) then (oui)
    fork
      :Mettre à jour le planning;
    fork again
      :Décrémenter le solde;
    end fork
    :Notifier le salarié (accord);
  else (non)
    :Notifier le salarié (refus motivé);
  endif

else (non)
  :Rejeter automatiquement;
  note right
    Aucun responsable n'est
    sollicité dans ce cas.
  end note
endif

:Archiver la demande;

stop

@enduml
