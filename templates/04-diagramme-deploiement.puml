' Diagramme de déploiement — répartition physique des artefacts
' @categorie structurel
@startuml
title Déploiement du poste utilisateur

' ── Formalisme commun — voir docs/formalisme.md ──────────────────────
' Palette : fond cyan clair, bordures et flèches bleues, têtes d'acteurs
' en jaune pâle. Les états initiaux et finaux restent des cercles pleins.
<style>
root {
  FontName "Segoe UI"
  FontSize 12
  BackGroundColor #FFFFFF
  LineColor #1E90FF
  LineThickness 1.5
}
element {
  BackGroundColor #D9F6FB
  LineColor #1E90FF
  FontColor #10314A
}
arrow {
  LineColor #1E90FF
  FontColor #333333
}
activityDiagram {
  circle {
    BackGroundColor #1E90FF
    LineColor #1E90FF
  }
}
stateDiagram {
  circle {
    BackGroundColor #1E90FF
    LineColor #1E90FF
  }
}
</style>
skinparam shadowing false
' Les conteneurs (cadre système, paquetages, nœuds) restent transparents :
' seuls les éléments qu'ils portent sont colorés, comme dans le formalisme de
' référence.
skinparam rectangleBackgroundColor transparent
skinparam packageBackgroundColor transparent
skinparam nodeBackgroundColor transparent
skinparam folderBackgroundColor transparent
skinparam frameBackgroundColor transparent
skinparam cloudBackgroundColor transparent
skinparam actorBackgroundColor #FFF6B0
skinparam actorBorderColor #1E90FF
' Marqueurs de visibilité littéraux + - # plutôt que des icônes colorées
skinparam classAttributeIconSize 0
' « Il est représenté par un dossier avec son nom à l'intérieur »
skinparam packageStyle folder
' Pointes de flèches UML strictes : synchrone, asynchrone, retour
skinparam style strictuml

' Un nœud est un cube : il représente une ressource matérielle ou d'exécution.
node "Poste de travail (Windows / macOS / Linux)" as poste {
  artifact "PlantUML Studio.exe" as App

  node "Processus Electron" {
    component "Main process" as Main
    component "Renderer" as Renderer
  }

  node "Machine virtuelle Java" as JVM {
    artifact "plantuml.jar" as Jar
  }

  folder "Dossier utilisateur" {
    file "projet.plantumlproj" as Projet
    file "diagramme.puml" as Source
    file "diagramme.png" as Rendu
  }
}

cloud "Réseau" as Net #line.dashed

App --> Main
Main --> Renderer : IPC
Main --> JVM : child_process
Jar --> Rendu : génère
Main --> Projet : lit / écrit
Main --> Source : lit / écrit
Main .[#B22222,dashed].> Net : bloqué

note right of Net
  Aucune connexion sortante :
  l'application fonctionne
  intégralement hors ligne.
end note

@enduml
