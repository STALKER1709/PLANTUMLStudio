' Diagramme de composants — briques logicielles et interfaces échangées
' @categorie structurel
@startuml
title Architecture applicative — composants

skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam packageStyle folder

package "Poste de travail" {
  [Interface React] as UI
  [Éditeur Monaco] as Editeur
}

package "Processus principal" {
  [Contrôleur IPC] as IPC
  [Service PlantUML] as Moteur
  [Service Fichiers] as Fichiers
  [Service Export] as Export
}

package "Ressources embarquées" {
  [plantuml.jar] as Jar
  [JRE] as Jre
  [Graphviz] as Graphviz
}

' Interface requise / fournie : notation « boule et douille ».
interface "API contextBridge" as API
interface "stdin / stdout" as Pipe

UI -down- API
API -down- IPC
Editeur -right-> UI

IPC --> Moteur
IPC --> Fichiers
IPC --> Export

Moteur -down- Pipe
Pipe -down- Jar
Jar ..> Jre : exécuté par
Jar ..> Graphviz : mise en page

Export --> Moteur : réutilise le rendu SVG

@enduml
