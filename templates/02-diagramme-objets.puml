' Diagramme d'objets — instantané d'instances à un moment donné
' @categorie structurel
@startuml
title Instantané — commande n° 2024-0157

' ── Formalisme commun — voir docs/formalisme.md ──────────────────────
' Palette : fond cyan clair, bordures et flèches bleues, têtes d'acteurs
' en jaune pâle. Les états initiaux et finaux restent des cercles pleins.
<style>
root {
  FontName "Segoe UI"
  FontSize 12
  BackGroundColor #FFFFFF
  LineColor #1E90FF
  LineThickness 1.5
}
element {
  BackGroundColor #D9F6FB
  LineColor #1E90FF
  FontColor #10314A
}
arrow {
  LineColor #1E90FF
  FontColor #333333
}
activityDiagram {
  circle {
    BackGroundColor #1E90FF
    LineColor #1E90FF
  }
}
stateDiagram {
  circle {
    BackGroundColor #1E90FF
    LineColor #1E90FF
  }
}
</style>
skinparam shadowing false
' Tracés orthogonaux, comme dans les outils de modélisation classiques.
' Cette directive exige Graphviz ; le moteur Smetana l'ignore et trace des
' courbes, sans que le diagramme cesse d'être correct.
skinparam linetype ortho
' Les conteneurs (cadre système, paquetages, nœuds) restent transparents :
' seuls les éléments qu'ils portent sont colorés, comme dans le formalisme de
' référence.
skinparam rectangleBackgroundColor transparent
skinparam packageBackgroundColor transparent
skinparam nodeBackgroundColor transparent
skinparam folderBackgroundColor transparent
skinparam frameBackgroundColor transparent
skinparam cloudBackgroundColor transparent
skinparam actorBackgroundColor #FFF6B0
skinparam actorBorderColor #1E90FF
' Marqueurs de visibilité littéraux + - # plutôt que des icônes colorées
skinparam classAttributeIconSize 0
' « Il est représenté par un dossier avec son nom à l'intérieur »
skinparam packageStyle folder
' Pointes de flèches UML strictes : synchrone, asynchrone, retour
skinparam style strictuml

' Une instance se nomme « nomInstance : Classe » et son nom est souligné.
object "client : Client" as client {
  identifiant = "3f2a-91cd"
  nom = "Dupont"
  courriel = "m.dupont@exemple.fr"
}

object "commande : Commande" as commande {
  numero = "2024-0157"
  date = 2024-11-05
  statut = VALIDEE
}

object "ligne1 : LigneCommande" as ligne1 {
  quantite = 2
  prixUnitaire = 19.90
}

object "ligne2 : LigneCommande" as ligne2 {
  quantite = 1
  prixUnitaire = 249.00
}

object "clavier : Produit" as clavier {
  reference = "KB-104"
  libelle = "Clavier mécanique"
  prix = 19.90
}

object "ecran : Produit" as ecran {
  reference = "SC-27"
  libelle = "Écran 27 pouces"
  prix = 249.00
}

' Les liens sont les instances des associations du diagramme de classes :
' ils en reprennent la nature (composition, référence) sans multiplicités.
client -- commande
commande *-- ligne1
commande *-- ligne2
ligne1 --> clavier
ligne2 --> ecran

@enduml
